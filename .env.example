# Copy to .env and fill in. Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive user agent: <platform>:<app id>:<version> (by /u/<your reddit username>)
REDDIT_USER_AGENT=python:social-link-analyzer:0.1 (account relationship research)
# Optional: where the SQLite database lives (default: ./data/social_graph.db)
# SLA_DB_PATH=
